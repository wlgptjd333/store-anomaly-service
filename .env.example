# 복사해서 .env 로 쓰기:  cp .env.example .env
# .env 는 Git 에 올리지 않는다 (.gitignore)

# NVIDIA GPU 가 있으면 AI 서버를 GPU 로 (Pose 11m). GPU 가 없으면 이 줄을 지운다 → CPU 로 돌지만 느림
COMPOSE_FILE=compose.yaml:compose.gpu.yaml

# Django — 실제 값은 직접 만든 긴 무작위 문자열로 바꾼다
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# HTTPS(앞단 프록시) 로 열 때만 1: 쿠키 secure·http→https 이동·HSTS. 내부망 http 시연에서는 0
DJANGO_HTTPS=0

# PostgreSQL
POSTGRES_DB=store_anomaly
POSTGRES_USER=store_anomaly
POSTGRES_PASSWORD=change-me

# IP Webcam — 처음 migrate 때 카메라 표(DB)로 한 번 옮기는 초기값. "이름=주소", 여러 개는 쉼표로
#   이후 휴대폰 IP 가 바뀌면 웹 화면(관리자) IP Webcam 탭 → "카메라 주소 관리"에서 바꾼다 (재시작 불필요)
#   휴대폰 IP Webcam 앱의 영상 주소는 보통 http://<휴대폰 IP>:8080/video
IPWEBCAM_CAMERAS=phone=http://192.168.0.10:8080/video
# 관리자가 등록할 수 있는 카메라 주소 범위 (Docker 내부망·localhost 는 일부러 뺌)
CAMERA_ALLOWED_NETWORKS=192.168.0.0/16,10.0.0.0/8
CAPTURE_SECONDS=8

MAX_UPLOAD_MB=100
